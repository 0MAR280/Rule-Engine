local userCachePaths = PATHS.userCache

-- Module
local BALANCES = {
	coins = {
		type = ENUMS.ParamOpTypes.DataPath,
		path = userDataPaths.coins,
	},

	points = {
		type = ENUMS.ParamOpTypes.CachePath,
		path = userCachePaths.points,
	},

	playtime = {
		type = ENUMS.ParamOpTypes.CachePath,
		path = userCachePaths.playtime,
	},
}

return BALANCES
