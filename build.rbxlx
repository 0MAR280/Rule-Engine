	[ENUMS.ConditionOpTypes.GreaterThan] = require(script.GreaterThan),
	[ENUMS.ConditionOpTypes.LessThanOrEqual] = require(script.LessThanOrEqual),
	[ENUMS.ConditionOpTypes.LessThan] = require(script.LessThan),
